# YouTube Data API Configuration
# Get your API key from: https://console.developers.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: OAuth2 credentials for authenticated requests
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=http://localhost:3000/oauth2callback

# Spotify Web API Configuration
# Get your credentials from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_SECRET=your_spotify_client_secret_here

# Chartmetric API Configuration
# Get your refresh token from: https://api.chartmetric.com/
CHARTMETRICS_API_KEY=your_chartmetric_refresh_token_here

# Cloudflare R2 Storage Configuration (Optional)
# Required for screenshot storage with storage_provider=cloudflare
# Get credentials from: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=your_r2_bucket_name_here
R2_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev

# Proxy Configuration (Optional)
# Enable proxy for Instagram and other endpoints to bypass bot detection
# Oxylabs proxy service: https://oxylabs.io/
USE_PROXY=false
OXYLABS_PROXY_SERVER=http://pr.oxylabs.io:7777
OXYLABS_USERNAME=your_oxylabs_username_here
OXYLABS_PASSWORD=your_oxylabs_password_here

# ScrapingBee Configuration
# Used by /api/tiktok/tagged-music (default provider) to fetch page HTML.
# Get your API key from: https://app.scrapingbee.com/
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here

# Source Authorization Reference Sheet
# Google Sheet (shared with the service account below) listing pre-authorized
# handles/domains. Used by the Sheets Processor to populate
# client_category_override = "source_authorized". Defaults to the sheet the
# team always uses for this; override only to point at a different one.
AUTHORIZED_SOURCES_SHEET_ID=1ywzW-DUhDm3XFTvipDcIQ27c-pJxQxrhKFN0WgIGnIY

# Artist Record Enrichment
# Get your Serper.dev key from: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here
# ANTHROPIC_API_KEY is also required for enrichment (already used by /api/sheets/ask)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional tuning:
# ENRICHMENT_CONCURRENCY=3
# ENRICHMENT_MAX_ROWS=500
# ENRICHMENT_MAX_BYTES=2097152
# ENRICHMENT_MAX_SERP_PER_ROW=5
# ENRICHMENT_LLM_MODEL=claude-sonnet-4-5
# ENRICHMENT_DATA_DIR=./data/enrichment
